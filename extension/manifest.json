{
  "manifest_version": 3,
  "name": "EHZAHGAH FINANCE",
  "version": "0.1.0",
  "description": "Makes digital financial interfaces understandable in Cameroonian national languages, without touching the site's source code.",
  "icons": {
    "16": "logo.png",
    "32": "logo.png",
    "48": "logo.png",
    "128": "logo.png"
  },
  "permissions": ["storage", "activeTab"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["engine.js", "content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "EHZAHGAH FINANCE",
    "default_icon": "logo.png",
    "default_popup": "popup.html"
  }
}
