{
  "manifest_version": 3,
  "name": "Ehzahgah_finance",
  "version": "0.1.0",
  "description": "Makes digital financial interfaces understandable in Cameroonian national languages, without touching the site's source code.",
  "permissions": ["storage", "activeTab"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["engine.js", "content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Ehzahgah_finance",
    "default_popup": "popup.html"
  }
}
